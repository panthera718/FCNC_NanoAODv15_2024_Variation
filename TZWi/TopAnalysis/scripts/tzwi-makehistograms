#!/usr/bin/env python3

from ROOT import *
import yaml
import sys, os
from array import array

if len(sys.argv) < 6:
    print("Usage: tzwi-makehistograms BASE_CUT BASE_WEIGHT CONFIG_FILE INPUT_NTUPLE_DIR OUTPUT_DIR [LEGACY_EXTERNAL_FILELIST_TXT]")
    sys.exit(1)

baseCut = sys.argv[1] ## Baseline cut to apply for every steps. "1" not to apply any cut
baseWeight = sys.argv[2] ## Baseline weight. this can be overridden by weight definition in the config file
configFile = sys.argv[3] ## the yaml file which defines cut steps and histograms
dName = sys.argv[4] ## directory name which contains ntuples
odName = sys.argv[5] ## output directory name
legacyExternalFileList = sys.argv[6] if len(sys.argv) >= 7 else None
if legacyExternalFileList in (None, "", "None", "none", "NULL", "null", "-"):
    legacyExternalFileList = None

config = yaml.safe_load(open(configFile))
steps = config['steps']
hists = config['hists']

ofName = odName+'/'+os.path.basename(dName)+".root"
if os.path.exists(ofName): sys.exit(1)
if not os.path.exists(odName):
    try: os.makedirs(odName)
    except: pass

#chain = TChain("Friends")
chain = TChain("Events")
chain.Add(dName+"/*_Skim.root")
gROOT.SetBatch(True)

if 'NPROC' in os.environ:
    nProc = os.environ['NPROC']
    prf = TProof.Open("workers=%s" % nProc)
    chain.SetProof(True)

print("Processing", ofName)
# A sixth argument may still be passed by older driver scripts.
# It is intentionally ignored: normalization now comes from the new NTuple/skim ROOT files.

oFile = TFile(ofName, 'recreate')

hWeights = {}
for istep, step in enumerate(steps):
    weights = baseWeight.split('*')
    if 'weightsToDrop' in step:
        weights = list(set(weights)-set(step['weightsToDrop']))

    cuts = [baseCut]+step['cuts']
    cut = '&&'.join(['(%s)' % x for x in cuts])

    dout = oFile.mkdir(step['name'])
    dout.cd()

    ## Fill Weight histogram first
    hWeight = TH1D("hWeight", "weight;weight;Events", 150, -5, 10)
    hWeight.Sumw2()
    chain.Draw("%s>>hWeight" % ('*'.join(weights)), cut, "goff")
    hWeight.Write()
    hWeights[step['name']] = hWeight

    ## Fill histograms in this step
    if 'hists' not in step: continue
    for hname, hdef in [(x, hists[x]) for x in step['hists'] if x in hists]:
        h = None
        bins = hdef['bins']
        if type(bins) == list:
            if len(bins) == 2 and type(bins[0]) == list:
                h = TH2D('h'+hname, hdef['title'], len(bins[0])-1, array('d', bins[0]),
                                               len(bins[1])-1, array('d', bins[1]))
            else:
                h = TH1D('h'+hname, hdef['title'], len(bins)-1, array('d', bins))
        else:
            if 'nbinsY' in bins:
                h = TH2D('h'+hname, hdef['title'], bins['nbinsX'], bins['xmin'], bins['xmax'],
                                               bins['nbinsY'], bins['ymin'], bins['ymax'])
            else:
                h = TH1D('h'+hname, hdef['title'], bins['nbinsX'], bins['xmin'], bins['xmax'])
        h.Sumw2()
        #h.SetDirectory(dout)

        expr = hdef['expr'] if 'expr' in hdef else hname

        weights1 = weights[:]
        if 'weightsToDrop' in hdef:
            weights1 = list(set(weights)-set(hdef['weightsToDrop']))
        weight1 = '*'.join(weights1)

        cuts1 = cuts[:]
        if 'cuts' in hdef:
            cuts1 = list(set(cuts)|set(hdef['cuts']))
        if 'cutsToDrop' in hdef:
            cuts1 = list(set(cuts)-set(hdef['cutsToDrop']))
        cut1 = '&&'.join(['(%s)' % x for x in cuts1 if x != "1"])
        if cut1 == "": cut1 = "1"

        if weight1 != "1":
            chain.Draw("%s>>h%s" % (expr, hname), "(%s)*(%s)" % (weight1, cut1), "goff")
        else:
            chain.Draw("%s>>h%s" % (expr, hname), "(%s)" % (cut1), "goff")

        h.Write()
        del h

def _get_chain_file_names(chain):
    """Return ROOT file names already attached to the Events TChain."""
    files = []
    tfiles = chain.GetListOfFiles()
    for i in range(tfiles.GetEntries()):
        files.append(tfiles.At(i).GetTitle())
    return files

def _get_gen_event_sumw_from_runs(fin):
    """Return sum of Runs.genEventSumw for one MC NTuple/skim ROOT file.

    For data files this branch is expected to be absent; absence alone is not
    an error. The caller decides whether a missing branch should be reported.
    """
    runs = fin.Get("Runs")
    if not runs or not runs.InheritsFrom("TTree"):
        return None
    if not runs.GetBranch("genEventSumw"):
        return None

    sumw = 0.0
    for ientry in range(runs.GetEntries()):
        runs.GetEntry(ientry)
        sumw += float(runs.genEventSumw)
    return sumw

def _get_mc_count_from_runs_or_events(fin, events):
    """Return MC generated event count from Runs.genEventCount, or Events.GetEntries().

    For MC, Runs.genEventCount is the natural companion of Runs.genEventSumw.
    It represents the pre-skim/generated counter stored by the producer.
    """
    runs = fin.Get("Runs")
    if runs and runs.InheritsFrom("TTree") and runs.GetBranch("genEventCount"):
        count = 0.0
        for ientry in range(runs.GetEntries()):
            runs.GetEntry(ientry)
            count += float(runs.genEventCount)
        return count
    if events and events.InheritsFrom("TTree"):
        return float(events.GetEntries())
    return None

def _get_data_count_from_events(events):
    """Return the number of events stored in the skim/NTuple Events tree for data.

    Do not use Runs.genEventCount for data.  In many skimmed NTuples the Runs
    tree can contain bookkeeping counters inherited from the parent NanoAOD or
    from run/luminosity-block bookkeeping, which can be much larger than the
    actual number of events stored in the skim file.
    """
    if events and events.InheritsFrom("TTree"):
        return float(events.GetEntries())
    return None

def _get_sum_genweight_from_events_tree(events, file_index):
    """Fallback: return sum of Events.genWeight for one MC file.

    The intended Run-3 NanoAODv15 denominator is Runs.genEventSumw. This
    fallback is used only when a non-standard MC skim/NTuple file has Events
    with genWeight but lacks Runs.genEventSumw.
    """
    if not events or not events.GetBranch("genWeight"):
        return None

    hname = "__hGenWeightSum_%d_%d" % (os.getpid(), file_index)
    old_dir = gDirectory
    gROOT.cd()
    old_obj = gROOT.FindObject(hname)
    if old_obj:
        old_obj.Delete()

    events.Draw("1>>%s(1,0,2)" % hname, "genWeight", "goff")
    hsum = gROOT.FindObject(hname)
    if not hsum:
        if old_dir:
            old_dir.cd()
        print("[WARNING] Could not create temporary genWeight-sum histogram for file index:", file_index)
        return None

    sumw = hsum.GetBinContent(1)
    hsum.Delete()
    if old_dir:
        old_dir.cd()
    return float(sumw)

def get_ntuple_normalization_from_chain(chain):
    """Compute normalization counters from the new NTuple/skim ROOT files.

    MC:
      denominator = sum over skim files and Runs entries of Runs.genEventSumw.
      If an MC file lacks Runs.genEventSumw, fall back to sum Events.genWeight
      with a warning.

    Data:
      Runs.genEventSumw is not expected. Do not print warnings for its absence.
      The first cut-flow bin is set to the number of entries actually stored
      in the new skim/NTuple Events trees, not to Runs.genEventCount.
    """
    file_names = _get_chain_file_names(chain)
    total_sumw = 0.0
    total_count = 0.0
    found_sumw = False
    found_count = False
    n_mc_files = 0
    n_data_files = 0

    if len(file_names) == 0:
        print("[WARNING] No skim/NTuple ROOT files found in input directory:", dName)
        return total_sumw, total_count, found_sumw, found_count, n_mc_files, n_data_files

    print("[INFO] Computing normalization from new NTuple/skim ROOT files:", dName)
    print("[INFO] Number of skim/NTuple files:", len(file_names))

    for idx, fName in enumerate(file_names):
        fin = TFile.Open(fName)
        if (not fin) or fin.IsZombie():
            print("[WARNING] Could not open skim/NTuple file for normalization:", fName)
            continue

        events = fin.Get("Events")
        if not events or not events.InheritsFrom("TTree"):
            print("[WARNING] No Events TTree in skim/NTuple file:", fName)
            fin.Close()
            continue

        is_mc = bool(events.GetBranch("genWeight"))

        if is_mc:
            n_mc_files += 1
            sumw = _get_gen_event_sumw_from_runs(fin)
            if sumw is None:
                print("[WARNING] No Runs.genEventSumw in MC skim/NTuple file; falling back to Events.genWeight sum:", fName)
                sumw = _get_sum_genweight_from_events_tree(events, idx)
            if sumw is None:
                print("[WARNING] Could not get MC normalization sumw from Runs.genEventSumw or Events.genWeight:", fName)
            else:
                total_sumw += sumw
                found_sumw = True
        else:
            # Data has no genWeight and no Runs.genEventSumw. This is normal.
            n_data_files += 1

        if is_mc:
            count = _get_mc_count_from_runs_or_events(fin, events)
            if count is None:
                print("[WARNING] Could not get MC event count from Runs.genEventCount or Events entries:", fName)
            else:
                total_count += count
                found_count = True
        else:
            # For data, count only the events actually present in the new
            # skim/NTuple.  Do not use Runs.genEventCount.
            count = _get_data_count_from_events(events)
            if count is None:
                print("[WARNING] Could not get data event count from Events entries:", fName)
            else:
                total_count += count
                found_count = True

        fin.Close()

        if (idx + 1) % 20 == 0 or (idx + 1) == len(file_names):
            print("[INFO]   processed %d/%d skim/NTuple files" % (idx + 1, len(file_names)))

    print("[INFO] Computed normalization from new NTuple/skim files:")
    if found_sumw:
        print("       MC nEventsGenWeighted = sum Runs.genEventSumw =", total_sumw)
    elif n_mc_files == 0:
        print("       Data sample: Runs.genEventSumw is not required.")
    else:
        print("       MC nEventsGenWeighted was not found.")
    if found_count:
        print("       nEvents               =", total_count)
    print("       nMCFiles              =", n_mc_files)
    print("       nDataFiles            =", n_data_files)

    return total_sumw, total_count, found_sumw, found_count, n_mc_files, n_data_files

oFile.cd()
hCutFlow = TH1D("hCutFlow", "Cut flow;;Events", len(steps)+1, 0, len(steps)+1)
hCutFlowNW = TH1D("hCutFlowNW", "Cut flow No Weight;;Events (unweighted)", len(steps)+1, 0, len(steps)+1)
hCutFlow.Sumw2()
hCutFlowNW.Sumw2()
for istep, step in enumerate(steps):
    stepName = step['name']

    hCutFlow.GetXaxis().SetBinLabel(istep+2, stepName)
    hCutFlowNW.GetXaxis().SetBinLabel(istep+2, stepName)

    nEventNW = hWeights[stepName].GetEntries()
    avgW = hWeights[stepName].GetMean()
    hCutFlowNW.SetBinContent(istep+2, nEventNW)
    #hCutFlowNW.SetBinError(istep+2, sqrt(nEventNW))
    hCutFlow.SetBinContent(istep+2, nEventNW*avgW)
    #rmsW = hWeights[step['name']].GetRMS()
    #hCutFlow.SetBinError(istep+2, sqrt(rms*avgW*nEventNW))

norm_sumw, norm_count, found_sumw, found_count, n_mc_files, n_data_files = get_ntuple_normalization_from_chain(chain)

if found_sumw:
    # MC: denominator for xsec*lumi normalization.
    hCutFlow.SetBinContent(1, norm_sumw)
elif n_mc_files == 0 and found_count:
    # Data: no genWeight and no Runs.genEventSumw. Use the event count for a
    # sane first bin and avoid irrelevant genEventSumw warnings.
    hCutFlow.SetBinContent(1, norm_count)
else:
    print("[WARNING] MC nEventsGenWeighted was not found and could not be computed.")
    print("          hCutFlow bin 1 will remain 0 for:", ofName)

if found_count:
    hCutFlowNW.SetBinContent(1, norm_count)
else:
    print("[WARNING] nEvents was not found and could not be computed.")
    print("          hCutFlowNW bin 1 will remain 0 for:", ofName)

oFile.cd()
hCutFlow.Write()
hCutFlowNW.Write()
oFile.Close()
